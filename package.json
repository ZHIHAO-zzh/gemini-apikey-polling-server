{
  "name": "gemini-apikey-polling-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Google Gemini API Key Load Balancer & Polling Gateway with Persistent State, Dashboard & Analytics",
  "main": "dist/index.js",
  "scripts": {
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "vite web",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "build:web": "vite build web",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/index.js"
  },
  "keywords": [
    "gemini",
    "google-ai",
    "api-gateway",
    "load-balancer",
    "round-robin",
    "api-keys"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "undici": "^7.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.9",
    "chart.js": "^4.4.8",
    "concurrently": "^9.1.2",
    "lucide-vue-next": "^0.475.0",
    "pinia": "^3.0.1",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.0",
    "@vitejs/plugin-vue": "^5.2.1"
  }
}
